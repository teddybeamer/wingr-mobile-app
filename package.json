{
  "name": "wingr-mobile-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@solar-icons/react-native": "^1.1.1",
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lottie-react-native": "~7.3.1",
    "nativewind": "^4.2.4",
    "posthog-react-native": "^4.66.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "^10.8.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "node scripts/with-staging-env.js start --dev-client --clear",
    "start:dev-client": "node scripts/with-staging-env.js start --dev-client --clear",
    "start:staging": "node scripts/with-staging-env.js start --dev-client --clear",
    "android": "expo run:android",
    "ios": "node scripts/with-staging-env.js run:ios --device",
    "ios:staging": "node scripts/with-staging-env.js run:ios --device",
    "staging:check": "node scripts/with-staging-env.js --check",
    "web": "expo start --web",
    "test": "tsx --test lib/*.test.ts supabase/functions/_shared/*.test.ts scripts/*.test.js",
    "test:db-concurrency": "bash supabase/tests/database/ai_generation_concurrency.integration.sh",
    "typecheck": "node --stack-size=8192 node_modules/typescript/bin/tsc --noEmit && tsc -p supabase/tsconfig.json"
  },
  "private": true
}
