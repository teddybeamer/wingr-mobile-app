# Copy this file to .env.staging.local. That local file is ignored by Git.
# This endpoint is intentionally fixed by scripts/with-staging-env.js so a
# staging command cannot accidentally point at production.
EXPO_PUBLIC_WINGR_API_BASE_URL=https://driytnlagwgzebnfdpcr.supabase.co/functions/v1

# Paste the publishable key for Supabase project driytnlagwgzebnfdpcr here.
# Do not commit the real value.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_STAGING_SUPABASE_PUBLISHABLE_KEY_HERE

# Paste the Wingr App Store iOS public SDK key (appl_...) used for Apple Sandbox
# purchases. Do not commit the real value.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=PASTE_STAGING_REVENUECAT_IOS_PUBLIC_SDK_KEY_HERE
